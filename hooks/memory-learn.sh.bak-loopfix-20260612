#!/bin/bash
# Stop hook: 세션 종료 시 LanceDB + 마크다운 동시 저장

set -uo pipefail
[ -z "${CLAUDE_SKIP_MEMORY_LEARN:-}" ] || exit 0

MEM_DIR="$HOME/.claude/memory"
mkdir -p "$MEM_DIR"

INPUT=$(cat 2>/dev/null || echo "")
TRANSCRIPT_PATH=$(echo "$INPUT" | python3 -c "
import json, sys
try:
    d = json.load(sys.stdin)
    print(d.get('transcript_path', '') or '')
except:
    print('')
" 2>/dev/null || echo "")

[ -n "$TRANSCRIPT_PATH" ] && [ -f "$TRANSCRIPT_PATH" ] || exit 0

TURNS=$(python3 -c "
import json, sys
msgs = []
try:
    with open(sys.argv[1], encoding='utf-8') as f:
        for line in f:
            try:
                d = json.loads(line.strip())
                t = d.get('type', '')
                if t not in ('user', 'assistant'):
                    continue
                c = d.get('message', {}).get('content', '')
                if isinstance(c, list):
                    c = ' '.join(x.get('text','') for x in c if isinstance(x, dict) and x.get('type')=='text')
                c = str(c).strip()
                if not c or c.startswith('<local-command') or c.startswith('<system'):
                    continue
                msgs.append(('U' if t=='user' else 'A') + ': ' + c[:400])
            except:
                pass
except:
    pass
print('\n'.join(msgs[-20:]))
" "$TRANSCRIPT_PATH" 2>/dev/null || echo "")

TURN_COUNT=$(echo "$TURNS" | grep -c '^[UA]:' 2>/dev/null || echo 0)
[ "$TURN_COUNT" -ge 5 ] || exit 0

DATE=$(date +%Y-%m-%d)
TIME=$(date +%H%M)
SESSION_FILE="$MEM_DIR/session_${DATE}_${TIME}.md"
TURNS_COPY="$TURNS"

PROMPT="아래 대화에서 이 사람을 이해하는 데 도움이 되는 정보를 추출하라. 업무 내용보다 이 사람이 어떤 사람인지에 집중. 없는 항목은 완전히 생략.

대화:
${TURNS_COPY}

형식 (없는 항목 생략):
## 성향 / 말투
- (짜증 표현 방식, 유머, 직접성, 반응 패턴 등)

## 관심사 / 고민
- (업무 외 개인적 관심사, 이직·커리어·인생 고민 등)

## 이 세션에서 새로 알게 된 것
- (새로 드러난 선호, 불만, 기대, 가치관)

## 진행 중 작업 (신규 또는 상태 변경된 것만)
-"

{
    EXTRACT=$(echo "$PROMPT" | CLAUDE_SKIP_MEMORY_LEARN=1 claude -p 2>/dev/null | head -40 || echo "")
    [ -n "$EXTRACT" ] || exit 0

    SESSION_CONTENT="# 세션: ${DATE} ${TIME}

${EXTRACT}
"
    # 마크다운 저장 (기존 방식 유지)
    echo "$SESSION_CONTENT" > "$SESSION_FILE"

    {
        echo "# 이전 세션 메모리"
        echo ""
        ls -t "${MEM_DIR}"/session_*.md 2>/dev/null | head -10 | while IFS= read -r f; do
            cat "$f"
            echo "---"
        done
    } > "${MEM_DIR}/LATEST.md"

    # LanceDB에도 저장
    python3 -c "
import sys
sys.path.insert(0, '$HOME/.claude/bin')
try:
    import mem_db
    content = '''${SESSION_CONTENT}'''
    chunks = [content[i:i+600] for i in range(0, len(content), 600)]
    for chunk in chunks:
        chunk = chunk.strip()
        if chunk and len(chunk) > 30:
            mem_db.add(chunk, source='session_${DATE}_${TIME}.md', agent='claude')
except Exception as e:
    pass
" 2>/dev/null || true

    # Wiki 자동 재빌드
    python3 "$HOME/.claude/bin/wiki_builder.py" 2>/dev/null || true

    echo "💾 [MEMORY-LEARN] 저장: ${SESSION_FILE}" >&2
} > /dev/null 2>&1 &
disown $!

exit 0
